<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.studentmanage.MainController" >  <top>
    <VBox alignment="CENTER" spacing="10.0" BorderPane.alignment="CENTER">
        <children>
            <Label text="Student Management System" alignment="CENTER">
                <font>
                    <Font name="System Bold" size="18.0" />
                </font>
            </Label>
            <GridPane hgap="10.0" vgap="10.0" alignment="CENTER">
                <columnConstraints>
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="150.0" />
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="150.0" />
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                </rowConstraints>
                <children>
                    <Label text="Name:" />
                    <TextField fx:id="nameField" GridPane.columnIndex="1" />
                    <Label text="ID:" GridPane.rowIndex="1" />
                    <TextField fx:id="idField" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                    <Label text="Department:" GridPane.rowIndex="2" />
                    <ComboBox fx:id="deptComboBox" prefWidth="200.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                    <Label text="Email:" GridPane.columnIndex="2" />
                    <TextField fx:id="emailField" GridPane.columnIndex="3" />
                    <Label text="CGPA:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                    <TextField fx:id="cgpaField" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                </children>
            </GridPane>

            <HBox alignment="CENTER" spacing="15.0">
                <children>
                    <Button fx:id="addButton" onAction="#handleAddStudent" text="Add Student (Create)" />
                    <Button fx:id="updateButton" onAction="#handleUpdateStudent" text="Update Student" disable="true" />
                    <Button fx:id="deleteButton" onAction="#handleDeleteStudent" text="Delete Student (Delete)" disable="true" />
                    <Button onAction="#handleClearFields" text="Clear Fields" />
                </children>
            </HBox>

            <HBox alignment="CENTER" spacing="10.0">
                <TextField fx:id="searchField" promptText="Search by Name, ID, or Dept" prefWidth="300.0" />
                <Button onAction="#handleSearch" text="Search" /> <Button onAction="#handleClearSearch" text="Show All" /> </HBox>
        </children>
    </VBox>
</top>
    <center>
        <TableView fx:id="studentTable" BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="nameCol" text="Name" prefWidth="150.0" />
                <TableColumn fx:id="idCol" text="ID" prefWidth="100.0" />
                <TableColumn fx:id="deptCol" text="Department" prefWidth="120.0" />
                <TableColumn fx:id="emailCol" text="Email" prefWidth="200.0" />
                <TableColumn fx:id="cgpaCol" text="CGPA" prefWidth="80.0" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </center>
</BorderPane>